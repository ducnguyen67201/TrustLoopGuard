# Schema is defined in crates/tl-server/src/config.rs and validated
# at startup via figment + serde. Copy to .env (gitignored) for local
# overrides; production should inject these via Doppler (PR 7).
#
# All keys are prefixed TL_SERVER_*. The figment Env provider
# lowercases the suffix and maps it to the matching field on Config.

# Address the HTTP listener binds to. Defaults to 0.0.0.0:8080.
TL_SERVER_LISTEN_ADDR=0.0.0.0:8080

# Comma-separated list of policy YAML paths to load on startup.
# Empty by default.
# TL_SERVER_POLICY_PATHS=policies/refund-promise.yaml,policies/pii.yaml

# Logging is controlled via the standard tracing-subscriber env filter:
# RUST_LOG=info,tl_server=debug
