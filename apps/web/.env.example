# Schema is defined in apps/web/env.ts and validated at build time
# via @t3-oss/env-nextjs. Copy this file to .env.local for local
# overrides; do not commit .env.local.

# tl-server base URL the playground hits. Public because the browser
# performs the request directly; do not put privileged tokens here.
NEXT_PUBLIC_TL_SERVER_URL=http://localhost:8080

# Postgres URL the web app reads its auth tables from. Same database
# tl-server uses; the web app's tables are prefixed auth_ to stay out
# of the Rust migrator's way.
DATABASE_URL=postgres://trustloop:trustloop@localhost:5432/trustloop

# Used by Auth.js to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# When true (default), /signup is exposed and the email/password
# Credentials provider is registered. Set to false in cloud deploys
# that should rely solely on Google OAuth.
AUTH_ALLOW_SIGNUP=true

# Google OAuth — set both, or leave both unset to disable Google sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set to true when running behind a reverse proxy or in a hosted
# environment where the request host differs from the bind host.
AUTH_TRUST_HOST=false
