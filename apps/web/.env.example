# Schema is defined in apps/web/env.ts and validated at build time
# via @t3-oss/env-nextjs. Copy this file to .env.local for local
# overrides; do not commit .env.local.

# tl-server base URL the playground hits. Public because the browser
# performs the request directly; do not put privileged tokens here.
NEXT_PUBLIC_TL_SERVER_URL=http://localhost:8080
