# Schema is defined in apps/web/env.ts and validated at build time
# via @t3-oss/env-nextjs.
#
# Doppler is the source of truth for real env values. The repo's
# doppler.yaml links apps/web to project trustloopguard, config dev.
# Use this file only as a reference for required secret names.

# Canonical dashboard URL used by Auth.js for redirects/callbacks.
# Production: https://app.gettrustloop.app
# Staging: https://staging3.gettrustloop.app
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# tl-server public API URL for browser-safe runtime calls.
# Production/staging should use the hosted Rust API, not localhost.
NEXT_PUBLIC_TL_SERVER_URL=http://localhost:8080

# Optional app environment override. Accepted values: dev, development, staging, prod, production.
# When omitted, the app derives this from VERCEL_ENV / NODE_ENV.
# NEXT_PUBLIC_APP_ENV=development

# Optional docs URL override.
# Production: https://app.gettrustloop.app/apps/doc
# Staging: https://staging3.gettrustloop.app/apps/doc
# NEXT_PUBLIC_DOCS_URL=http://localhost:3001/docs

# Postgres URL the web app reads its auth tables from. Same database
# tl-server uses; the web app's tables are prefixed auth_ to stay out
# of the Rust migrator's way.
DATABASE_URL=postgres://trustloop:trustloop@localhost:5432/trustloop

# Used by Auth.js to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# OAuth-only authentication. Configure at least one provider in Doppler.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Base URL of the standalone red-team backend behind the /arena demo.
# The arena page calls the same-origin route /api/arena/redteam, which proxies
# here. Run the TrustLoopRed backend locally: uvicorn runner:app --port 8799
REDTEAM_RUNNER_URL=http://127.0.0.1:8799
