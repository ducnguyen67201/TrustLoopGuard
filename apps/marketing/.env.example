# Schema is defined in apps/marketing/env.ts and validated at build time
# via @t3-oss/env-nextjs.

NEXT_PUBLIC_GITHUB_REPO=ducnguyen67201/TrustLoopGuard
NEXT_PUBLIC_BOOK_MEETING_URL=https://calendar.app.google/aQc6ws3pDWpUKFzS9
NEXT_PUBLIC_SITE_URL=https://gettrustloop.app
NEXT_PUBLIC_DOCS_URL=https://docs.gettrustloop.app/
NEXT_PUBLIC_GTM_ID=

# Server-side: where /api/subscribe forwards waitlist signups (Apps Script/Slack/Zapier/Buttondown).
# Signups return an error to the visitor until this is set. Use a matching secret when the sink supports it.
WAITLIST_WEBHOOK_URL=
WAITLIST_WEBHOOK_SECRET=
