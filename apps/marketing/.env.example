# Schema is defined in apps/marketing/env.ts and validated at build time
# via @t3-oss/env-nextjs.

NEXT_PUBLIC_GITHUB_REPO=ducnguyen67201/FeatherlaneAI
NEXT_PUBLIC_BOOK_MEETING_URL=https://calendar.app.google/aQc6ws3pDWpUKFzS9
NEXT_PUBLIC_SITE_URL=https://featherlane.ai
NEXT_PUBLIC_DOCS_URL=https://docs.featherlane.ai/
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_replaceWithProjectToken
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side: where /api/subscribe forwards waitlist signups (Apps Script/Slack/Zapier/Buttondown).
# Signups return an error to the visitor until this is set. Use a matching secret when the sink supports it.
WAITLIST_WEBHOOK_URL=
WAITLIST_WEBHOOK_SECRET=

# Server-side URL for the SDK-backed refund demo service. Loopback HTTP is accepted locally;
# deployed services must use HTTPS. Never put Stripe or OpenAI keys in browser-visible variables.
REFUND_DEMO_SERVICE_URL=http://127.0.0.1:9310
# Shared only by the marketing proxy and refund service. Generate at least 32 random characters.
REFUND_DEMO_PROXY_SECRET=

# Server-only runtime credentials for the in-process healthcare scheduling demo.
# healthcare-agent:setup prints the workspace-scoped key once. Store it in the
# deployment secret manager. Never deploy TL_API_KEY or TL_ADMIN_USER_ID with Marketing.
TL_SERVER_URL=http://127.0.0.1:8080
TL_HEALTHCARE_DEMO_API_KEY=
TL_CONTEXTUAL_DEMO_API_KEY=
OPENAI_API_KEY=

# Private server-only Postgres URL for personalized outbound demo profiles.
# Never expose this value through a NEXT_PUBLIC_* variable.
OUTBOUND_DEMO_DATABASE_URL=

# Public dashboard origin used by the held-demo review link.
# Local: http://localhost:3000; production: https://app.featherlane.ai
NEXT_PUBLIC_FEATHERLANE_AI_APP_URL=http://localhost:3000
