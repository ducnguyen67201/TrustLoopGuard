{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentProfile",
  "description": "What an agent is, what it may claim, and how it should sound.\n\nAuthored as YAML by the customer (see `policies/agents/*.yaml`), parsed by `tl-policy::load_agent_str`, persisted in Postgres, cached in process, and consulted by Tier 2 (out-of-scope embedding lookup) and Tier 3 (LLM judge ground truth).",
  "type": "object",
  "required": [
    "agent_id",
    "authority",
    "display_name",
    "scope",
    "tone"
  ],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "authority": {
      "$ref": "#/definitions/AgentAuthority"
    },
    "display_name": {
      "type": "string"
    },
    "escalation_triggers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_sources": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/KnowledgeSource"
      }
    },
    "scope": {
      "$ref": "#/definitions/AgentScope"
    },
    "system_prompt": {
      "description": "Raw system prompt the customer ships to their LLM. Source of truth for auto-generating guardrails: `POST /v1/agents/{id}/guardrails:generate` reads this and asks an LLM to derive a policy set tailored to it. Optional at the type level so existing profiles keep deserializing; the generate endpoint enforces presence at call time.",
      "type": [
        "string",
        "null"
      ]
    },
    "tone": {
      "$ref": "#/definitions/AgentTone"
    }
  },
  "definitions": {
    "AgentAuthority": {
      "type": "object",
      "properties": {
        "can_promise": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cannot_promise": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "AgentScope": {
      "type": "object",
      "properties": {
        "in_scope": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "AgentTone": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "forbidden": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": "string"
        }
      }
    },
    "KnowledgeSource": {
      "type": "object",
      "required": [
        "kb_id"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "kb_id": {
          "type": "string"
        },
        "kind": {
          "default": "local",
          "allOf": [
            {
              "$ref": "#/definitions/KnowledgeSourceKind"
            }
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "KnowledgeSourceKind": {
      "type": "string",
      "enum": [
        "local",
        "web"
      ]
    }
  }
}
