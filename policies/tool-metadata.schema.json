{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolMetadata",
  "type": "object",
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalRule"
        },
        {
          "type": "null"
        }
      ]
    },
    "params": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ParamSpec"
      }
    },
    "reversible": {
      "type": "boolean"
    },
    "sandbox_hint": true,
    "side_effect": {
      "$ref": "#/$defs/SideEffectClass"
    },
    "tool": {
      "type": "string"
    }
  },
  "required": [
    "tool",
    "side_effect",
    "reversible"
  ],
  "$defs": {
    "AllowedSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "origin"
      ]
    },
    "ApprovalRule": {
      "type": "object",
      "properties": {
        "approver_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ]
    },
    "LimitAction": {
      "description": "The authorization effect a [`ParamLimit`] breach maps to. `Deny` is the safe\ndefault for money movement; `RequireApproval` routes a breach to review.",
      "type": "string",
      "enum": [
        "deny",
        "require_approval"
      ]
    },
    "Origin": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "tool",
        "memory",
        "file",
        "web",
        "email",
        "api",
        "unknown"
      ]
    },
    "ParamLimit": {
      "description": "Inclusive numeric bounds for a parameter, expressed in the tool's own\nminor units (e.g. cents for a money amount). The value-limit checker\nreads the parameter at [`ParamSpec::path`], coerces it to an integer,\nand emits [`on_breach`](ParamLimit::on_breach) when it falls outside\n`[min, max]`. Integer units keep the type `Eq` and sidestep float\ncomparison ambiguity; the checker is currency-agnostic, so the registry\nauthor is responsible for declaring `max`/`min` in the same unit the\nagent passes.",
      "type": "object",
      "properties": {
        "max": {
          "description": "Inclusive maximum. A value greater than this breaches the limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "min": {
          "description": "Inclusive minimum. A value less than this breaches the limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "on_breach": {
          "description": "Authorization effect to recommend when a bound is breached. Defaults to `Deny`.",
          "$ref": "#/$defs/LimitAction",
          "default": "deny"
        }
      }
    },
    "ParamRole": {
      "type": "string",
      "enum": [
        "authority_bearing",
        "content_bearing"
      ]
    },
    "ParamSpec": {
      "type": "object",
      "properties": {
        "allowed_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AllowedSource"
          }
        },
        "limit": {
          "description": "Optional inclusive numeric bounds on this parameter's value, checked\nby the value-limit checker. `None` means the value is unconstrained.",
          "anyOf": [
            {
              "$ref": "#/$defs/ParamLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ParamRole"
        }
      },
      "required": [
        "path",
        "role"
      ]
    },
    "SideEffectClass": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "external_communication",
        "file_write",
        "shell_exec",
        "network_call",
        "db_mutation",
        "api_mutation",
        "memory_write",
        "publish"
      ]
    }
  }
}
