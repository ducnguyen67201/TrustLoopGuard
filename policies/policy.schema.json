{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Policy",
  "type": "object",
  "required": [
    "action",
    "id",
    "match"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/Action"
    },
    "id": {
      "type": "string"
    },
    "match": {
      "$ref": "#/definitions/MatchClause"
    },
    "rewrite": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "default": "medium",
      "allOf": [
        {
          "$ref": "#/definitions/Severity"
        }
      ]
    },
    "when": {
      "default": {
        "channel": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/WhenClause"
        }
      ]
    }
  },
  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "allow",
        "block",
        "rewrite",
        "escalate"
      ]
    },
    "Channel": {
      "description": "Channel an agent is operating on. Drives latency budget and matcher selection.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "voice",
            "chat",
            "email"
          ]
        },
        {
          "type": "object",
          "required": [
            "other"
          ],
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "MatchClause": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Matcher"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Matcher"
              }
            }
          }
        },
        {
          "$ref": "#/definitions/Matcher"
        }
      ]
    },
    "Matcher": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "regex"
          ],
          "properties": {
            "regex": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "semantic"
          ],
          "properties": {
            "semantic": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "WhenClause": {
      "type": "object",
      "properties": {
        "channel": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Channel"
          }
        }
      }
    }
  }
}
