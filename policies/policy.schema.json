{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/AuthorizationEffect"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "id": {
      "type": "string"
    },
    "match": {
      "$ref": "#/$defs/MatchClause"
    },
    "owner_agent_id": {
      "description": "Agent that owns this policy. Set by\n`POST /v1/agents/{id}/guardrails:generate` so deleting the agent\ncan cascade-delete its generated policies. `None` for global\npolicies authored directly via `POST /v1/policies`.",
      "type": [
        "string",
        "null"
      ]
    },
    "rewrite": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "medium"
    },
    "when": {
      "$ref": "#/$defs/WhenClause",
      "default": {
        "agents": [],
        "channels": [],
        "domains": []
      }
    }
  },
  "required": [
    "id",
    "match",
    "action"
  ],
  "$defs": {
    "AuthorizationEffect": {
      "description": "The only runtime decision vocabulary.",
      "type": "string",
      "enum": [
        "permit",
        "deny",
        "transform",
        "require_approval",
        "defer"
      ]
    },
    "Channel": {
      "description": "Channel an agent is operating on. Drives latency budget and matcher selection.\n\nFlat enum on the wire so SDK type generation stays clean across languages.\nNew channels are added as variants here; we don't carry a free-form\n`Other(String)` because it pollutes the Pydantic / TS surface.",
      "type": "string",
      "enum": [
        "voice",
        "chat",
        "email"
      ]
    },
    "MatchClause": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Matcher"
              }
            }
          },
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Matcher"
              }
            }
          },
          "required": [
            "all"
          ]
        },
        {
          "$ref": "#/$defs/Matcher"
        }
      ]
    },
    "Matcher": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "regex": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "regex"
          ]
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "literal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "semantic": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "semantic"
          ]
        }
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "WhenClause": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "channels": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Channel"
          }
        },
        "domains": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
