{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Policy",
  "type": "object",
  "required": [
    "action",
    "id",
    "match"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/AuthorizationEffect"
    },
    "description": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "match": {
      "$ref": "#/definitions/MatchClause"
    },
    "owner_agent_id": {
      "description": "Agent that owns this policy. Set by `POST /v1/agents/{id}/guardrails:generate` so deleting the agent can cascade-delete its generated policies. `None` for global policies authored directly via `POST /v1/policies`.",
      "type": [
        "string",
        "null"
      ]
    },
    "rewrite": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "default": "medium",
      "allOf": [
        {
          "$ref": "#/definitions/Severity"
        }
      ]
    },
    "when": {
      "default": {
        "agents": [],
        "channels": [],
        "domains": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/WhenClause"
        }
      ]
    }
  },
  "definitions": {
    "AuthorizationEffect": {
      "description": "The only runtime decision vocabulary.",
      "type": "string",
      "enum": [
        "permit",
        "deny",
        "transform",
        "require_approval",
        "defer"
      ]
    },
    "Channel": {
      "description": "Channel an agent is operating on. Drives latency budget and matcher selection.\n\nFlat enum on the wire so SDK type generation stays clean across languages. New channels are added as variants here; we don't carry a free-form `Other(String)` because it pollutes the Pydantic / TS surface.",
      "type": "string",
      "enum": [
        "voice",
        "chat",
        "email"
      ]
    },
    "MatchClause": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Matcher"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Matcher"
              }
            }
          }
        },
        {
          "$ref": "#/definitions/Matcher"
        }
      ]
    },
    "Matcher": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "regex"
          ],
          "properties": {
            "regex": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "semantic"
          ],
          "properties": {
            "semantic": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "WhenClause": {
      "type": "object",
      "properties": {
        "agents": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channels": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Channel"
          }
        },
        "domains": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
