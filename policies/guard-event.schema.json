{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GuardEvent",
  "type": "object",
  "required": [
    "action",
    "kind",
    "principal"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/Action"
    },
    "context": {
      "default": null
    },
    "kind": {
      "$ref": "#/definitions/EventKind"
    },
    "principal": {
      "$ref": "#/definitions/Principal"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Source"
      }
    }
  },
  "definitions": {
    "Action": {
      "type": "object",
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "parameters": {
          "default": null
        },
        "side_effect": {
          "anyOf": [
            {
              "$ref": "#/definitions/SideEffectClass"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Confidentiality": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "secret",
        "identity",
        "unknown"
      ]
    },
    "EventKind": {
      "type": "string",
      "enum": [
        "output.proposed",
        "tool.call.proposed",
        "memory.write.proposed",
        "memory.retrieval.used_for_action",
        "file.action.proposed",
        "shell.action.proposed",
        "network.request.proposed",
        "browser.action.proposed",
        "database.mutation.proposed",
        "api.mutation.proposed",
        "external_message.proposed"
      ]
    },
    "Integrity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "Labels": {
      "type": "object",
      "properties": {
        "confidentiality": {
          "default": "unknown",
          "allOf": [
            {
              "$ref": "#/definitions/Confidentiality"
            }
          ]
        },
        "integrity": {
          "default": "unknown",
          "allOf": [
            {
              "$ref": "#/definitions/Integrity"
            }
          ]
        },
        "trust": {
          "default": "unknown",
          "allOf": [
            {
              "$ref": "#/definitions/Trust"
            }
          ]
        }
      }
    },
    "Origin": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "tool",
        "memory",
        "file",
        "web",
        "email",
        "api",
        "unknown"
      ]
    },
    "Principal": {
      "type": "object",
      "required": [
        "agent_id",
        "environment_id",
        "workspace_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "environment_id": {
          "type": "string"
        },
        "run_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      }
    },
    "SideEffectClass": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "external_communication",
        "file_write",
        "shell_exec",
        "network_call",
        "db_mutation",
        "api_mutation",
        "memory_write",
        "publish"
      ]
    },
    "Source": {
      "type": "object",
      "required": [
        "id",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "default": {
            "confidentiality": "unknown",
            "integrity": "unknown",
            "trust": "unknown"
          },
          "allOf": [
            {
              "$ref": "#/definitions/Labels"
            }
          ]
        },
        "origin": {
          "$ref": "#/definitions/Origin"
        }
      }
    },
    "Trust": {
      "type": "string",
      "enum": [
        "trusted",
        "untrusted",
        "unknown"
      ]
    }
  }
}
