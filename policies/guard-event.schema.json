{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GuardEvent",
  "type": "object",
  "required": [
    "action",
    "kind",
    "principal"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/Action"
    },
    "context": {
      "default": null
    },
    "kind": {
      "$ref": "#/definitions/EventKind"
    },
    "principal": {
      "$ref": "#/definitions/Principal"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "resolution": {
      "description": "Registry resolution evidence attached by the event pipeline. `None` until the pipeline has run.",
      "anyOf": [
        {
          "$ref": "#/definitions/ToolResolution"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Source"
      }
    }
  },
  "definitions": {
    "Action": {
      "type": "object",
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "parameters": {
          "default": null
        },
        "side_effect": {
          "anyOf": [
            {
              "$ref": "#/definitions/SideEffectClass"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AllowedSource": {
      "type": "object",
      "required": [
        "origin"
      ],
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/definitions/Origin"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ApprovalRule": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "approver_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "Confidentiality": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "secret",
        "identity",
        "unknown"
      ]
    },
    "EventKind": {
      "type": "string",
      "enum": [
        "output.proposed",
        "tool.call.proposed",
        "memory.write.proposed",
        "memory.retrieval.used_for_action",
        "file.action.proposed",
        "shell.action.proposed",
        "network.request.proposed",
        "browser.action.proposed",
        "database.mutation.proposed",
        "api.mutation.proposed",
        "external_message.proposed"
      ]
    },
    "Integrity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "Labels": {
      "type": "object",
      "properties": {
        "confidentiality": {
          "default": "unknown",
          "allOf": [
            {
              "$ref": "#/definitions/Confidentiality"
            }
          ]
        },
        "integrity": {
          "default": "unknown",
          "allOf": [
            {
              "$ref": "#/definitions/Integrity"
            }
          ]
        },
        "trust": {
          "default": "unknown",
          "allOf": [
            {
              "$ref": "#/definitions/Trust"
            }
          ]
        }
      }
    },
    "Origin": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "tool",
        "memory",
        "file",
        "web",
        "email",
        "api",
        "unknown"
      ]
    },
    "ParamRole": {
      "type": "string",
      "enum": [
        "authority_bearing",
        "content_bearing"
      ]
    },
    "ParamSpec": {
      "type": "object",
      "required": [
        "path",
        "role"
      ],
      "properties": {
        "allowed_sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AllowedSource"
          }
        },
        "path": {
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/ParamRole"
        }
      }
    },
    "Principal": {
      "type": "object",
      "required": [
        "agent_id",
        "environment_id",
        "workspace_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "environment_id": {
          "type": "string"
        },
        "run_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      }
    },
    "SideEffectClass": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "external_communication",
        "file_write",
        "shell_exec",
        "network_call",
        "db_mutation",
        "api_mutation",
        "memory_write",
        "publish"
      ]
    },
    "Source": {
      "type": "object",
      "required": [
        "id",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "default": {
            "confidentiality": "unknown",
            "integrity": "unknown",
            "trust": "unknown"
          },
          "allOf": [
            {
              "$ref": "#/definitions/Labels"
            }
          ]
        },
        "origin": {
          "$ref": "#/definitions/Origin"
        }
      }
    },
    "ToolMetadata": {
      "type": "object",
      "required": [
        "reversible",
        "side_effect",
        "tool"
      ],
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/definitions/ApprovalRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParamSpec"
          }
        },
        "reversible": {
          "type": "boolean"
        },
        "sandbox_hint": true,
        "side_effect": {
          "$ref": "#/definitions/SideEffectClass"
        },
        "tool": {
          "type": "string"
        }
      }
    },
    "ToolResolution": {
      "description": "Outcome of resolving an event's `action.operation` against the workspace tool-metadata registry. Evidence only — observe-only phases never change a decision because of this value.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "metadata",
            "status"
          ],
          "properties": {
            "metadata": {
              "$ref": "#/definitions/ToolMetadata"
            },
            "status": {
              "type": "string",
              "enum": [
                "resolved"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "unregistered"
              ]
            }
          }
        }
      ]
    },
    "Trust": {
      "type": "string",
      "enum": [
        "trusted",
        "untrusted",
        "unknown"
      ]
    }
  }
}
