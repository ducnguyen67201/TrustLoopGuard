{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardEvent",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/Action"
    },
    "checks": {
      "description": "Checker evaluation evidence attached by the event pipeline.\nServer-populated: the pipeline resets this before evaluating, so\ncollector-submitted values never survive.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CheckerRun"
      }
    },
    "context": {
      "default": null
    },
    "kind": {
      "$ref": "#/$defs/EventKind"
    },
    "label_resolution": {
      "description": "Label resolution evidence attached by the event pipeline.\n`None` until the pipeline has run.",
      "anyOf": [
        {
          "$ref": "#/$defs/LabelResolution"
        },
        {
          "type": "null"
        }
      ]
    },
    "principal": {
      "$ref": "#/$defs/Principal"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "resolution": {
      "description": "Registry resolution evidence attached by the event pipeline.\n`None` until the pipeline has run.",
      "anyOf": [
        {
          "$ref": "#/$defs/ToolResolution"
        },
        {
          "type": "null"
        }
      ]
    },
    "signals": {
      "description": "Advisory signal evidence attached by the event pipeline.\nServer-populated: the pipeline resets this before evaluating, so\ncollector-submitted values never survive. Signals never change\nthe decision.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SignalEvidence"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Source"
      }
    }
  },
  "required": [
    "kind",
    "principal",
    "action"
  ],
  "$defs": {
    "Action": {
      "type": "object",
      "properties": {
        "authorization": {
          "description": "Opaque grant claim submitted only on a resumed attempt. The\nserver extracts and clears it before trace persistence.",
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationClaim"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "type": "string"
        },
        "parameters": {
          "default": null
        },
        "side_effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/SideEffectClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation"
      ]
    },
    "AllowedSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "origin"
      ]
    },
    "ApprovalRule": {
      "type": "object",
      "properties": {
        "approver_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ]
    },
    "AuthorizationClaim": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "grant_id": {
          "type": "string"
        }
      },
      "required": [
        "grant_id",
        "attempt_id"
      ]
    },
    "AuthorizationEffect": {
      "description": "The only runtime decision vocabulary.",
      "type": "string",
      "enum": [
        "permit",
        "deny",
        "transform",
        "require_approval",
        "defer"
      ]
    },
    "CheckerFindingEvidence": {
      "description": "One rule violation observed by a checker.\n\n`recommended_effect` is what enforce mode applies; in shadow mode it is\nthe hypothetical outcome and the decision is left untouched. It is\nabsent for effect-free evidence findings (e.g. \"tool not registered,\nparameters unverifiable\") that never affect the decision in any mode.",
      "type": "object",
      "properties": {
        "harm_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "recommended_effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationEffect"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule": {
          "type": "string"
        },
        "source_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "rule",
        "reason"
      ]
    },
    "CheckerRun": {
      "description": "Evidence for one checker evaluation, attached by the event pipeline.\n\nRecorded whenever a checker runs (shadow or enforce). A checker in\n`off` mode records nothing.",
      "type": "object",
      "properties": {
        "checker_id": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckerFindingEvidence"
          }
        },
        "mode": {
          "description": "Mode the checker ran under at evaluation time.",
          "$ref": "#/$defs/EnforcementMode"
        }
      },
      "required": [
        "checker_id",
        "mode"
      ]
    },
    "Confidentiality": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "secret",
        "identity",
        "unknown"
      ]
    },
    "EnforcementMode": {
      "description": "Rollout mode for one checker in one workspace.\n\n- `Off`: the checker is not evaluated; no evidence is recorded.\n- `Shadow`: the checker is evaluated and full hypothetical evidence is\n  recorded, but the decision is never changed.\n- `Enforce`: the checker is evaluated and its findings can change the\n  decision (the strongest authorization effect wins).",
      "type": "string",
      "enum": [
        "off",
        "shadow",
        "enforce"
      ]
    },
    "EventKind": {
      "type": "string",
      "enum": [
        "output.proposed",
        "tool.call.proposed",
        "memory.write.proposed",
        "memory.retrieval.used_for_action",
        "file.action.proposed",
        "shell.action.proposed",
        "network.request.proposed",
        "browser.action.proposed",
        "database.mutation.proposed",
        "api.mutation.proposed",
        "external_message.proposed"
      ]
    },
    "Integrity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "LabelBasis": {
      "description": "Why a resolved label family value was chosen.",
      "oneOf": [
        {
          "description": "Built-in default derived from the source origin.",
          "type": "string",
          "const": "origin_default"
        },
        {
          "description": "An enabled workspace `SourceLabelPolicy` override applied.",
          "type": "string",
          "const": "workspace_override"
        },
        {
          "description": "The producer declared the value and it was accepted.",
          "type": "string",
          "const": "declared"
        }
      ]
    },
    "LabelBasisSet": {
      "description": "Per-family basis for one source's resolved labels.",
      "type": "object",
      "properties": {
        "confidentiality": {
          "$ref": "#/$defs/LabelBasis"
        },
        "integrity": {
          "$ref": "#/$defs/LabelBasis"
        },
        "trust": {
          "$ref": "#/$defs/LabelBasis"
        }
      },
      "required": [
        "trust",
        "confidentiality",
        "integrity"
      ]
    },
    "LabelPolicyStatus": {
      "description": "How the workspace label policy read went during resolution.",
      "oneOf": [
        {
          "description": "No enabled policy rows configured for the workspace.",
          "type": "string",
          "const": "not_configured"
        },
        {
          "description": "Enabled policy rows were loaded and consulted.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "The policy store could not be consulted; built-in defaults used.",
          "type": "string",
          "const": "unavailable"
        }
      ]
    },
    "LabelResolution": {
      "description": "Label resolution + propagation evidence attached by the event\npipeline. `None` until the pipeline has run. Observe-only: no\nchecker changes an authorization effect because of this value.",
      "type": "object",
      "properties": {
        "derived": {
          "description": "Parameter path -> labels derived over provenance. A path absent\nfrom this map has unknown derivation — absence is never \"clean\".",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Labels"
          }
        },
        "policy_status": {
          "$ref": "#/$defs/LabelPolicyStatus"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceLabelEvidence"
          }
        }
      },
      "required": [
        "policy_status"
      ]
    },
    "Labels": {
      "type": "object",
      "properties": {
        "confidentiality": {
          "$ref": "#/$defs/Confidentiality",
          "default": "unknown"
        },
        "integrity": {
          "$ref": "#/$defs/Integrity",
          "default": "unknown"
        },
        "trust": {
          "$ref": "#/$defs/Trust",
          "default": "unknown"
        }
      }
    },
    "LimitAction": {
      "description": "The authorization effect a [`ParamLimit`] breach maps to. `Deny` is the safe\ndefault for money movement; `RequireApproval` routes a breach to review.",
      "type": "string",
      "enum": [
        "deny",
        "require_approval"
      ]
    },
    "Origin": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "tool",
        "memory",
        "file",
        "web",
        "email",
        "api",
        "unknown"
      ]
    },
    "ParamLimit": {
      "description": "Inclusive numeric bounds for a parameter, expressed in the tool's own\nminor units (e.g. cents for a money amount). The value-limit checker\nreads the parameter at [`ParamSpec::path`], coerces it to an integer,\nand emits [`on_breach`](ParamLimit::on_breach) when it falls outside\n`[min, max]`. Integer units keep the type `Eq` and sidestep float\ncomparison ambiguity; the checker is currency-agnostic, so the registry\nauthor is responsible for declaring `max`/`min` in the same unit the\nagent passes.",
      "type": "object",
      "properties": {
        "max": {
          "description": "Inclusive maximum. A value greater than this breaches the limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "min": {
          "description": "Inclusive minimum. A value less than this breaches the limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "on_breach": {
          "description": "Authorization effect to recommend when a bound is breached. Defaults to `Deny`.",
          "$ref": "#/$defs/LimitAction",
          "default": "deny"
        }
      }
    },
    "ParamRole": {
      "type": "string",
      "enum": [
        "authority_bearing",
        "content_bearing"
      ]
    },
    "ParamSpec": {
      "type": "object",
      "properties": {
        "allowed_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AllowedSource"
          }
        },
        "limit": {
          "description": "Optional inclusive numeric bounds on this parameter's value, checked\nby the value-limit checker. `None` means the value is unconstrained.",
          "anyOf": [
            {
              "$ref": "#/$defs/ParamLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ParamRole"
        }
      },
      "required": [
        "path",
        "role"
      ]
    },
    "Principal": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "environment_id": {
          "type": "string"
        },
        "run_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "environment_id",
        "agent_id"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "SideEffectClass": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "external_communication",
        "file_write",
        "shell_exec",
        "network_call",
        "db_mutation",
        "api_mutation",
        "memory_write",
        "publish"
      ]
    },
    "SignalEvidence": {
      "description": "Advisory evidence from one LLM/classifier signal provider, attached\nby the event pipeline.\n\nSignals never decide authorization effects: the composer ignores them for\neffect composition, and this evidence exists so traces and review\nshow what advisory layers observed.",
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider_id",
        "message"
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "$ref": "#/$defs/Labels",
          "default": {
            "confidentiality": "unknown",
            "integrity": "unknown",
            "trust": "unknown"
          }
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "id",
        "origin"
      ]
    },
    "SourceLabelEvidence": {
      "description": "Evidence of how one source's labels were resolved.",
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/LabelBasisSet"
        },
        "labels": {
          "$ref": "#/$defs/Labels"
        },
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "labels",
        "basis"
      ]
    },
    "ToolIdentity": {
      "type": "object",
      "properties": {
        "schema_hash": {
          "type": "string"
        },
        "server_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        }
      },
      "required": [
        "server_id",
        "tool_name",
        "schema_hash"
      ]
    },
    "ToolMetadata": {
      "type": "object",
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ParamSpec"
          }
        },
        "reversible": {
          "type": "boolean"
        },
        "sandbox_hint": true,
        "side_effect": {
          "$ref": "#/$defs/SideEffectClass"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "side_effect",
        "reversible"
      ]
    },
    "ToolResolution": {
      "description": "Outcome of resolving an event's `action.operation` against the\nworkspace tool-metadata registry. Resolved and unregistered outcomes are\nevidence for checkers and policies; resolution failure is a fail-closed\npipeline condition that defers execution.",
      "oneOf": [
        {
          "description": "The tool is registered and enabled; the registry's side-effect\nclass is authoritative for the event.",
          "type": "object",
          "properties": {
            "metadata": {
              "$ref": "#/$defs/ToolMetadata"
            },
            "status": {
              "type": "string",
              "const": "resolved"
            }
          },
          "required": [
            "status",
            "metadata"
          ]
        },
        {
          "description": "No enabled registry entry exists for the tool — the conservative\ndefault for unknown or disabled tools.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unregistered"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "The registry could not be consulted (e.g. storage failure).\nDistinguishes degraded resolution from genuine absence so traces\nstay accurate forensic evidence. Collector-claimed action semantics\nare discarded and execution is deferred until metadata is available.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "resolution_failed"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    },
    "Trust": {
      "type": "string",
      "enum": [
        "trusted",
        "untrusted",
        "unknown"
      ]
    }
  }
}
