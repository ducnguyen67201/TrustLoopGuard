{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceLabelPolicy",
  "description": "One workspace override row: per-origin label defaults. A family left\n`None` inherits the built-in origin default.",
  "type": "object",
  "properties": {
    "confidentiality": {
      "anyOf": [
        {
          "$ref": "#/$defs/Confidentiality"
        },
        {
          "type": "null"
        }
      ]
    },
    "integrity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Integrity"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "trust": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trust"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "origin"
  ],
  "$defs": {
    "Confidentiality": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "secret",
        "identity",
        "unknown"
      ]
    },
    "Integrity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "Origin": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "tool",
        "memory",
        "file",
        "web",
        "email",
        "api",
        "unknown"
      ]
    },
    "Trust": {
      "type": "string",
      "enum": [
        "trusted",
        "untrusted",
        "unknown"
      ]
    }
  }
}
