{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorizationDecision",
  "type": "object",
  "properties": {
    "applied_grant": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationGrantRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationApprovalSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "domain": {
      "$ref": "#/$defs/AuthorizationDomain"
    },
    "effect": {
      "$ref": "#/$defs/AuthorizationEffect"
    },
    "findings": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/AuthorizationFinding"
      }
    },
    "intent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "lease": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationLease"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string"
    },
    "receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationIntentStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "type": "string"
    },
    "transformed_value": true
  },
  "required": [
    "trace_id",
    "domain",
    "effect",
    "reason",
    "latency_ms"
  ],
  "$defs": {
    "ApprovalStatus": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "canceled",
        "expired"
      ]
    },
    "AuthorizationApprovalSummary": {
      "type": "object",
      "properties": {
        "envelope_hash": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "poll_after_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        }
      },
      "required": [
        "id",
        "status",
        "envelope_hash",
        "expires_at",
        "poll_after_ms"
      ]
    },
    "AuthorizationCapabilityId": {
      "type": "string"
    },
    "AuthorizationDomain": {
      "type": "string",
      "enum": [
        "content",
        "tool",
        "financial"
      ]
    },
    "AuthorizationEffect": {
      "description": "The only runtime decision vocabulary.",
      "type": "string",
      "enum": [
        "permit",
        "deny",
        "transform",
        "require_approval",
        "defer"
      ]
    },
    "AuthorizationFinding": {
      "type": "object",
      "properties": {
        "effect": {
          "$ref": "#/$defs/AuthorizationEffect"
        },
        "evidence": {
          "default": null
        },
        "id": {
          "type": "string"
        },
        "policy_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirement_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "effect",
        "reason",
        "severity"
      ]
    },
    "AuthorizationGrantRef": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/AuthorizationCapabilityId"
        },
        "id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/GrantMode"
        },
        "source": {
          "$ref": "#/$defs/AuthorizationGrantSource"
        }
      },
      "required": [
        "id",
        "capability",
        "mode",
        "source"
      ]
    },
    "AuthorizationGrantSource": {
      "type": "string",
      "enum": [
        "user_intent",
        "reviewer_approval",
        "workspace_admin"
      ]
    },
    "AuthorizationIntentStatus": {
      "type": "string",
      "enum": [
        "evaluating",
        "pending_approval",
        "authorized",
        "denied",
        "deferred",
        "canceled",
        "expired"
      ]
    },
    "AuthorizationLease": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "claimed_at": {
          "type": "string"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "grant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "intent_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/LeaseStatus"
        }
      },
      "required": [
        "id",
        "intent_id",
        "attempt_id",
        "fingerprint",
        "status",
        "claimed_at",
        "expires_at"
      ]
    },
    "GrantMode": {
      "type": "string",
      "enum": [
        "exact_once",
        "scoped"
      ]
    },
    "LeaseStatus": {
      "type": "string",
      "enum": [
        "claimed",
        "consumed",
        "canceled",
        "expired"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
