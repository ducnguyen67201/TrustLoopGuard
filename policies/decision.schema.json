{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision",
  "type": "object",
  "required": [
    "latency_ms",
    "reason",
    "trace_id",
    "triggered_policies",
    "verdict"
  ],
  "properties": {
    "checked_input_excerpt": {
      "type": [
        "string",
        "null"
      ]
    },
    "checked_output_excerpt": {
      "type": [
        "string",
        "null"
      ]
    },
    "constraints": true,
    "failure_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "harm_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "reason": {
      "type": "string"
    },
    "redaction": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/RedactionInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "remediation": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "safe_output": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_chain": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "tier_results": {
      "description": "Per-tier breakdown produced by the parallel-cancel orchestrator. Empty for callers that only ran the synchronous `Engine::check` path; populated when `Engine::check_async` is used.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/TierResult"
      }
    },
    "trace_id": {
      "type": "string"
    },
    "triggered_policies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TriggeredPolicy"
      }
    },
    "verdict": {
      "$ref": "#/definitions/Verdict"
    },
    "violated_rule": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "RedactedEntity": {
      "type": "object",
      "required": [
        "count",
        "entity_type",
        "token"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "entity_type": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      }
    },
    "RedactionInfo": {
      "type": "object",
      "required": [
        "context_redacted",
        "entities",
        "input_redacted",
        "mode",
        "proposed_output_redacted",
        "status"
      ],
      "properties": {
        "context_redacted": {
          "type": "boolean"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RedactedEntity"
          }
        },
        "input_redacted": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/definitions/RedactionMode"
        },
        "proposed_output_redacted": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/definitions/RedactionStatus"
        }
      }
    },
    "RedactionMode": {
      "type": "string",
      "enum": [
        "sdk_local",
        "customer_service",
        "server"
      ]
    },
    "RedactionStatus": {
      "type": "string",
      "enum": [
        "not_requested",
        "applied",
        "failed",
        "rejected_raw_sensitive_data"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "Tier": {
      "description": "Which pipeline tier produced a result.",
      "oneOf": [
        {
          "description": "Static matchers — regex, literal, PII patterns. Microsecond-scale.",
          "type": "string",
          "enum": [
            "deterministic"
          ]
        },
        {
          "description": "Embedding similarity + edit-distance bypass detection. ~5-20 ms.",
          "type": "string",
          "enum": [
            "fuzzy"
          ]
        },
        {
          "description": "LLM judges (hallucination, tone, authority). ~200-600 ms.",
          "type": "string",
          "enum": [
            "llm"
          ]
        }
      ]
    },
    "TierResult": {
      "description": "One row of evidence per tier in the final `Decision`.",
      "type": "object",
      "required": [
        "elapsed_ms",
        "status",
        "tier"
      ],
      "properties": {
        "elapsed_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "reasons": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/TriggeredPolicy"
          }
        },
        "status": {
          "$ref": "#/definitions/TierStatus"
        },
        "tier": {
          "$ref": "#/definitions/Tier"
        }
      }
    },
    "TierStatus": {
      "description": "How a tier finished.",
      "oneOf": [
        {
          "description": "Tier finished and contributed to the aggregated decision.",
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        {
          "description": "Tier was cancelled because an earlier tier produced a hard block.",
          "type": "string",
          "enum": [
            "cancelled"
          ]
        },
        {
          "description": "Tier exceeded its deadline and was treated as `Escalate`.",
          "type": "string",
          "enum": [
            "timed_out"
          ]
        },
        {
          "description": "Tier was not run (e.g. cache hit, or feature disabled by config).",
          "type": "string",
          "enum": [
            "skipped"
          ]
        }
      ]
    },
    "TriggeredPolicy": {
      "type": "object",
      "required": [
        "id",
        "reason",
        "severity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        }
      }
    },
    "Verdict": {
      "description": "What TrustLoopGuard tells the caller to do with the proposed output.",
      "type": "string",
      "enum": [
        "allow",
        "block",
        "rewrite",
        "escalate"
      ]
    }
  }
}
