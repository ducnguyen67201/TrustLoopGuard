# TrustLoopGuard repository/self-hosting — optional environment overrides.
#
# SDK customers should set TLG_URL and TLG_API_KEY in their own application.
# They do not need to copy this repository file.
#
# `docker compose up` requires the two secrets below. Copy this file to
# `.env`, generate distinct random values, and keep the resulting file local.

# Required by Docker Compose. Example generator: `openssl rand -hex 32`.
POSTGRES_PASSWORD=replace-with-a-random-local-database-password
TL_API_KEY=replace-with-a-random-local-api-key

# --- Production hardening ----------------------------------------------------

# Docker Compose uses TL_API_KEY above for the Rust service and web proxy.
# A bare `cargo run -p tl-server` may omit it only while listening on loopback.

# NextAuth secret for signed sessions. Required for production.
# AUTH_SECRET=

# Dedicated secret used by the Rust server to encrypt gateway provider
# credentials. Docker Compose provides a local-only default; set this in
# deployed environments.
# TL_GATEWAY_CREDENTIAL_KEY=

# Optional OAuth sign-in providers for the web dashboard.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Canonical dashboard URL used by Auth.js redirects/callbacks.
# Use https://staging3.gettrustloop.app in staging and
# https://app.gettrustloop.app in production. This must be the frontend
# app URL, not the Rust API URL.
# AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# --- Optional integrations ---------------------------------------------------

# Path inside the server container to a custom LLM routing config.
# (Mount the file via a compose override if you want to point here.)
# TL_LLM_CONFIG=/etc/trustloopguard/llm-routing.toml

# Webhook posted on escalation decisions.
# TL_ESCALATION_WEBHOOK_URL=https://hooks.example.com/tl

# Optional compatible private runner used by /v1/redteam/dispatch.
# Leave unset for public/local product work without managed red-team execution.
# REDTEAM_RUNNER_URL=http://127.0.0.1:8799

# Optional GitHub App used by GitHub-assisted agent installation.
# This is separate from Auth.js GitHub login above. Configure the GitHub App
# with selected-repository installs, Metadata read, Contents read/write, Pull
# requests write, setup URL `${DASHBOARD_URL}/api/github-integration/callback`,
# and webhook URL `${TL_PUBLIC_URL}/v1/github-integration/webhooks`.
# TL_GITHUB_APP_ID=
# TL_GITHUB_APP_SLUG=
# TL_GITHUB_CLIENT_ID=
# TL_GITHUB_CLIENT_SECRET=
# TL_GITHUB_PRIVATE_KEY_BASE64=
# TL_GITHUB_WEBHOOK_SECRET=
# TL_GITHUB_INTEGRATION_MODEL=gpt-4o-mini

# --- Web → server URL --------------------------------------------------------

# Browsers hit this URL directly. Default is `http://localhost:8080`,
# which works because compose publishes server's port to the host.
# Override only if you front the server with a different hostname.
# NEXT_PUBLIC_TL_SERVER_URL=http://localhost:8080

# Optional app environment override. Accepted values: dev, development, staging, prod, production.
# When omitted, the app derives this from VERCEL_ENV / NODE_ENV.
# NEXT_PUBLIC_APP_ENV=development

# Dashboard /docs redirects to this product docs URL.
# Use https://staging3.gettrustloop.app/apps/doc in staging and
# https://app.gettrustloop.app/apps/doc in production.
# NEXT_PUBLIC_DOCS_URL=http://localhost:3001/docs

# Next.js server/API routes use this URL internally. Local non-Docker dev
# defaults to IPv4 localhost to avoid Windows resolving `localhost` to ::1.
# Docker compose sets this to `http://server:8080`.
# TL_SERVER_URL=http://127.0.0.1:8080

# Canonical Rust public origin used by OAuth metadata and the managed /mcp resource.
# TL_PUBLIC_URL=https://guard.example.com
# Canonical dashboard origin hosting the employee OAuth consent screen.
# TL_DASHBOARD_URL=https://app.gettrustloop.app
# Dedicated secret used to seal provider and remote MCP bearer credentials.
# TL_GATEWAY_CREDENTIAL_KEY=
# Loopback-only escape hatch for fake HTTP MCP servers. Never enable in production.
# TL_MCP_GATEWAY_ALLOW_INSECURE_HTTP=false

# --- Logging -----------------------------------------------------------------

# tracing-subscriber EnvFilter syntax. Examples:
#   info                            (default)
#   info,tl_server=debug            (per-crate verbosity)
#   warn,tl_engine=trace
# RUST_LOG=info
