{
  "name": "@featherlane-ai/sdk",
  "version": "0.0.10",
  "description": "TypeScript SDK for Featherlane AI. Types are generated from Rust via tl-codegen; do not hand-edit src/generated.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducnguyen67201/FeatherlaneAI.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/ducnguyen67201/FeatherlaneAI/tree/main/sdks/typescript",
  "bugs": {
    "url": "https://github.com/ducnguyen67201/FeatherlaneAI/issues"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "guardrails",
    "security",
    "runtime-security",
    "agent-observability",
    "policy-enforcement",
    "tool-calls",
    "typescript",
    "sdk",
    "coverage"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/adapters/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node ./scripts/package-smoke.mjs",
    "prepack": "pnpm build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
