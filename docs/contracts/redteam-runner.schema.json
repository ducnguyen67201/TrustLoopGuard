{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RedteamRunnerContract",
  "description": "Codegen-only aggregator so a single JSON Schema document carries every runner\ntype in its `definitions`. Never constructed at runtime.",
  "type": "object",
  "properties": {
    "dispatch": {
      "$ref": "#/$defs/RunnerDispatch"
    },
    "handle": {
      "$ref": "#/$defs/RunnerHandle"
    },
    "plan": {
      "$ref": "#/$defs/RunnerPlanRequest"
    },
    "plan_result": {
      "$ref": "#/$defs/RunnerPlanResponse"
    },
    "report": {
      "$ref": "#/$defs/RunnerReport"
    }
  },
  "required": [
    "plan",
    "plan_result",
    "dispatch",
    "handle",
    "report"
  ],
  "$defs": {
    "RunnerAttackSession": {
      "description": "One independent attack session from the runner. The runner owns scoring;\nRust copies the verdict verbatim and never re-scores.",
      "type": "object",
      "properties": {
        "attack": {
          "type": "string"
        },
        "caseId": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "events": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunnerSessionEvent"
          }
        },
        "goal": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "landed": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string"
        },
        "runnerSessionId": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "seq": {
          "type": "integer",
          "format": "int32"
        },
        "sessionId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunnerStatus"
        },
        "traceId": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "track": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "trialIndex": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "sessionId",
        "seq",
        "attack",
        "goal",
        "status",
        "outcome",
        "landed"
      ]
    },
    "RunnerAttackSurface": {
      "description": "Target surface the private runner should attack.",
      "type": "string",
      "enum": [
        "chat",
        "document_workflow"
      ]
    },
    "RunnerAttackVector": {
      "description": "One tailored attack vector generated or consumed by the private runner.",
      "type": "object",
      "properties": {
        "goal": {
          "description": "What a successful attack makes the agent do (the runner's scoring goal).",
          "type": "string"
        },
        "injectionPayload": {
          "description": "Concrete seed payload; the runner strengthens it.",
          "type": "string"
        },
        "sourcePath": {
          "description": "Optional product-side source-to-sink provenance for this seed.",
          "anyOf": [
            {
              "$ref": "#/$defs/RunnerWorkflowPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetOperation": {
          "description": "Sink category the vector targets (`http`, `email_send`, …) or `chat_reply`.",
          "type": "string"
        },
        "technique": {
          "description": "Technique class, e.g. `data_exfiltration`, `scope_violation`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "goal",
        "technique",
        "targetOperation",
        "injectionPayload"
      ]
    },
    "RunnerDispatch": {
      "description": "Body of `POST /redteam/jobs`.",
      "type": "object",
      "properties": {
        "attackSurface": {
          "$ref": "#/$defs/RunnerAttackSurface"
        },
        "attackVectors": {
          "description": "Tailored seeds from the agent's `redteam/plan`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/RunnerAttackVector"
          }
        },
        "documentTemplate": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunnerDocumentTemplate"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "$ref": "#/$defs/RunnerRunMode"
        },
        "profile": {
          "type": "string"
        },
        "targetUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "targetUrl",
        "profile"
      ]
    },
    "RunnerDocumentTemplate": {
      "description": "Uploaded PDF form template for document workflow attacks.",
      "type": "object",
      "properties": {
        "dataBase64": {
          "type": "string"
        },
        "fields": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "fileName": {
          "type": "string"
        },
        "flatten": {
          "type": "boolean",
          "default": false
        },
        "mediaType": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "fileName",
        "mediaType",
        "dataBase64"
      ]
    },
    "RunnerHandle": {
      "description": "Response from `POST /redteam/jobs`.",
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "jobId"
      ]
    },
    "RunnerPlanRequest": {
      "description": "Body of `POST /redteam/plan`. TrustLoopGuard sends only the target agent's\nstructured context; the private runner owns attack-planner instructions and\nvector generation.",
      "type": "object",
      "properties": {
        "agentDisplayName": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunnerWorkflowPath"
          }
        },
        "systemPrompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflowPresent": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "agentDisplayName"
      ]
    },
    "RunnerPlanResponse": {
      "description": "Response from `POST /redteam/plan`.",
      "type": "object",
      "properties": {
        "vectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunnerAttackVector"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "vectors"
      ]
    },
    "RunnerReport": {
      "description": "Response from `GET /redteam/jobs/{id}`.",
      "type": "object",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sessions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunnerAttackSession"
          }
        },
        "status": {
          "$ref": "#/$defs/RunnerStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "status"
      ]
    },
    "RunnerRunMode": {
      "description": "Execution mode for the private runner.",
      "type": "string",
      "enum": [
        "one_off",
        "learning"
      ]
    },
    "RunnerSessionEvent": {
      "description": "One ordered event emitted while executing an attack session.",
      "type": "object",
      "properties": {
        "actor": {
          "type": "string"
        },
        "contentText": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "eventId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "payload": {
          "default": {}
        },
        "seq": {
          "type": "integer",
          "format": "int32"
        },
        "traceId": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "eventId",
        "seq",
        "kind",
        "actor"
      ]
    },
    "RunnerStatus": {
      "description": "Lifecycle the runner reports for one of its jobs.",
      "type": "string",
      "enum": [
        "running",
        "complete",
        "error"
      ]
    },
    "RunnerWorkflowPath": {
      "description": "Runner-side provenance for a planned source-to-sink attack path.",
      "type": "object",
      "properties": {
        "sinkCategory": {
          "type": "string"
        },
        "sinkNode": {
          "type": "string"
        },
        "sinkType": {
          "type": "string"
        },
        "sourceCategory": {
          "type": "string"
        },
        "sourceNode": {
          "type": "string"
        },
        "sourceType": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceNode",
        "sourceType",
        "sourceCategory",
        "sinkNode",
        "sinkType",
        "sinkCategory"
      ]
    }
  }
}
