vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 4
  }
}

direction: right

agent: {
  label: "Customer agent\ndrafts a reply or action"
  shape: rectangle
}

guard: {
  label: "TrustLoopGuard\ncheck()\npolicies + profile + context"
  shape: rectangle
}

target: {
  label: "User or tool\npermitted or transformed output"
  shape: rectangle
}

effects: {
  label: "Five effects\npermit | transform | require_approval | defer | deny"
  shape: rectangle
}

trace: {
  label: "Audit trace\nstored for review"
  shape: document
}

agent -> guard: "draft output"
guard -> target: "Authorization decision"
guard -> effects
guard -> trace
