{
  "name": "trustloopguard",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for the TrustLoopGuard JS/TS layer. Rust workspace lives in crates/ and is unaffected.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.12",
      "esbuild": "0.28.1",
      "postcss": "8.5.14",
      "undici": "7.28.0",
      "vite": "6.4.3"
    }
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:diagrams": "bash scripts/render-diagrams.sh",
    "marketing:dev": "pnpm --filter marketing dev",
    "marketing:build": "pnpm --filter marketing build",
    "test:marketing-use-cases": "tsx --test apps/marketing/app/use-cases/use-cases.test.ts",
    "test:marketing-nav": "tsx --test apps/marketing/components/nav.test.ts",
    "test:refund-demo": "tsx --tsconfig apps/marketing/tsconfig.json --test demo/stripe-refund-agent/agent.test.ts demo/stripe-refund-agent/auth.test.ts demo/stripe-refund-agent/core.test.ts demo/stripe-refund-agent/deployment.test.ts demo/stripe-refund-agent/hosted.test.ts demo/stripe-refund-agent/status.test.ts apps/marketing/app/demo/demo-contract.test.ts apps/marketing/app/demo/status-model.test.ts apps/marketing/app/api/demo/refund/route.test.ts apps/marketing/app/api/demo/refund/provider/payments/route.test.ts apps/marketing/single-service-deployment.test.ts",
    "build": "pnpm -r --filter \"@trustloopguard/sdk\" --filter web --filter docs --filter marketing build",
    "typecheck": "pnpm -r typecheck",
    "codegen": "cargo run -p tl-codegen",
    "codegen:check": "cargo run -p tl-codegen -- --check",
    "dead-code:check": "knip --no-progress --reporter markdown",
    "recipes:check": "tsx scripts/sync-recipes.ts check",
    "recipes:update": "tsx scripts/sync-recipes.ts update",
    "secrets:check": "secretlint \"**/*\"",
    "test:frontend": "pnpm --filter web test",
    "coverage:frontend": "pnpm --filter web test:coverage",
    "test:backend": "make backend-test",
    "coverage:backend": "make backend-coverage",
    "coverage:backend:lcov": "make backend-coverage-lcov",
    "lint:boundaries": "scripts/lint-storage-boundaries.sh && scripts/lint-no-internal-imports.sh && scripts/lint-api-contracts.sh && scripts/lint-web-backend-only.sh",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings",
    "lint": "pnpm lint:boundaries && pnpm lint:rust",
    "precommit:check": "lefthook run pre-commit --no-auto-install",
    "prepush:check": "bash scripts/prepush-fast.sh",
    "verify:full": "pnpm secrets:check && pnpm typecheck && pnpm test:frontend && pnpm test:backend && pnpm lint && pnpm codegen:check",
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "knip": "5.88.1",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "secretlint": "^13.0.2",
    "tsx": "^4.21.0",
    "yaml": "^2.9.0"
  }
}
