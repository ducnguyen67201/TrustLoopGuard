{
  "name": "trustloopguard",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for the TrustLoopGuard JS/TS layer. Rust workspace lives in crates/ and is unaffected.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "marketing:dev": "pnpm --filter marketing dev",
    "marketing:build": "pnpm --filter marketing build",
    "demo:chat": "pnpm --filter @trustloopguard/demo chat",
    "demo:chat:interactive": "pnpm --filter @trustloopguard/demo chat:interactive",
    "demo:job": "pnpm --filter @trustloopguard/demo job",
    "demo:n8n:bridge": "pnpm --filter @trustloopguard/demo n8n:bridge",
    "build": "pnpm -r --filter \"@trustloopguard/sdk\" --filter web --filter docs --filter marketing build",
    "typecheck": "pnpm -r typecheck",
    "codegen": "cargo run -p tl-codegen",
    "codegen:check": "cargo run -p tl-codegen -- --check",
    "recipes:check": "tsx scripts/sync-recipes.ts check",
    "recipes:update": "tsx scripts/sync-recipes.ts update",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:boundaries": "make ci-lint",
    "verify:full": "make ci"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "yaml": "^2.9.0"
  }
}
