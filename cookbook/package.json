{
  "name": "@trustloopguard/cookbook",
  "private": true,
  "version": "0.0.1",
  "description": "Small, runnable TrustLoopGuard examples.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "quickstart": "tsx 00_quickstart/run.ts",
    "test": "tsx --test 00_quickstart/agent.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=00_quickstart/agent.ts --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 00_quickstart/agent.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trustloopguard/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
