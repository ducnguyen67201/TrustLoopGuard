{
  "name": "@trustloopguard/demo",
  "private": true,
  "version": "0.0.1",
  "description": "SDK-backed TrustLoopGuard demos for the dispute and LiveKit surfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dispute": "pnpm run dispute:check",
    "dispute:setup": "tsx dispute/setup.ts",
    "dispute:setup:doppler": "doppler run --project trustloopguard --config dev_demo -- pnpm run dispute:setup",
    "dispute:serve": "tsx dispute/serve.ts",
    "dispute:serve:doppler": "doppler run --project trustloopguard --config dev_demo -- pnpm run dispute:serve",
    "dispute:check": "tsx dispute/dispute.check.ts",
    "dispute:scenarios": "tsx dispute/scenarios.ts",
    "dispute:scenarios:check": "tsx dispute/scenarios.check.ts",
    "dispute:byo": "tsx dispute/byo.example.ts",
    "financial-refund": "tsx financial-refund/scenarios.ts",
    "financial-refund:check": "tsx financial-refund/financial-refund.check.ts",
    "arena:check": "tsx arena/adapter.check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trustloopguard/sdk": "workspace:*",
    "openai": "^6.45.0",
    "pdfjs-dist": "^4.10.38",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
